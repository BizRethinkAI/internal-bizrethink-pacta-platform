# Why: packages/bizrethink/mca/sources/ holds the primary text every MCA
#      disclosure spec was transcribed from. `verifyProvenance` re-reads and
#      re-hashes those files on every run -- a verification date means "these
#      bytes have not moved since we checked", so without the bytes it means
#      nothing.
#
#      The runner stage copies only the built app plus the prisma schema and
#      migrations, so the sources were absent from the image. /admin/mca would
#      have reported SOURCE MISSING for all eleven states in production while
#      being green locally: the page telling the truth about a gap it had
#      itself created.
#
# Why not a new file: docker/Dockerfile is upstream. Same reason overlays 003
#      (heap size) and 031 (healthcheck) exist against this file.
#
# Fragility: LOW. One COPY line in the runner stage, anchored after the prisma
#      migrations copy. An upstream restructure of the runner stage would
#      conflict, and the failure is loud -- the page reports the sources
#      missing rather than silently passing.
#
# Size: 764K of text. Deliberately not copied into the build stages; nothing
#      compiles it, it is read at request time.
diff --git a/docker/Dockerfile b/docker/Dockerfile
index bdf91570e..2164c6d49 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -145,6 +145,22 @@ COPY --from=installer --chown=nodejs:nodejs /app/apps/remix/public ./apps/remix/
 COPY --from=installer --chown=nodejs:nodejs /app/packages/prisma/schema.prisma ./packages/prisma/schema.prisma
 COPY --from=installer --chown=nodejs:nodejs /app/packages/prisma/migrations ./packages/prisma/migrations
 
+# BIZRETHINK overlay 070: ship the vendored statutes.
+#
+# packages/bizrethink/mca/sources/ holds the primary text every MCA disclosure
+# spec was transcribed from. `verifyProvenance` re-reads those files on every
+# run and re-hashes them: a verification date means "these bytes have not moved
+# since we checked", and without the bytes it means nothing.
+#
+# The runner stage copies only the built app, so the sources were absent from
+# the image. /admin/mca would report SOURCE MISSING for all eleven states in
+# production while being green locally -- the page telling the truth about a
+# gap it had itself created.
+#
+# 764K of text. Kept out of the build stages deliberately: nothing compiles
+# them, they are read at request time.
+COPY --from=installer --chown=nodejs:nodejs /app/packages/bizrethink/mca/sources ./packages/bizrethink/mca/sources
+
 # Generate the prisma client again, this time only targeting the client generator
 RUN npx prisma generate --schema ./packages/prisma/schema.prisma --generator client \
     && npm cache clean --force
 
